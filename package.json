{
  "name": "vue3-performance-lab",
  "version": "1.0.0",
  "description": "Vue3 + Vite 性能优化实战学习项目",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "20.19.5",
    "pnpm": "10.23.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:analyze": "ANALYZE=true vite build",
    "typecheck": "vue-tsc -b --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@types/node": "^22.10.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.2.0"
  }
}
