{
  "name": "vue3-performance-lab",
  "version": "1.0.0",
  "description": "Vue3 + Vite 性能优化实战学习项目",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "20.19.5",
    "pnpm": "10.23.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:analyze": "ANALYZE=true vite build",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:style": "stylelint \"**/*.{vue,scss,css}\"",
    "lint:style:fix": "stylelint \"**/*.{vue,scss,css}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:all": "pnpm lint && pnpm lint:style && pnpm format:check"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "postcss-html": "^1.8.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
